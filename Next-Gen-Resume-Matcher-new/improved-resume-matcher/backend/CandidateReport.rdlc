<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">

  <!-- DATA SOURCE -->
  <DataSources>
    <DataSource Name="ResumeDataSource">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString />
      </ConnectionProperties>
      <rd:DataSourceID>12345678-abcd-1234-abcd-123456789012</rd:DataSourceID>
    </DataSource>
  </DataSources>

  <!-- DATASET -->
  <DataSets>
    <DataSet Name="CandidateDataSet">
      <Fields>
        <Field Name="Rank">
          <DataField>Rank</DataField>
        </Field>

        <Field Name="CandidateName">
          <DataField>CandidateName</DataField>
        </Field>

        <Field Name="Email">
          <DataField>Email</DataField>
        </Field>

        <Field Name="Score">
          <DataField>Score</DataField>
        </Field>

        <Field Name="Degree">
          <DataField>Degree</DataField>
        </Field>

        <Field Name="RoleApplied">
          <DataField>RoleApplied</DataField>
        </Field>
      </Fields>

      <Query>
        <DataSourceName>ResumeDataSource</DataSourceName>
        <CommandText />
      </Query>
    </DataSet>
  </DataSets>

  <Body>
    <ReportItems>

      <!-- REPORT TITLE -->
      <Textbox Name="ReportTitle">
        <Top>0in</Top>
        <Left>0in</Left>
        <Height>0.4in</Height>
        <Width>10in</Width>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>AI Resume Screening Report</Value>
                <Style>
                  <FontSize>16pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style/>
          </Paragraph>
        </Paragraphs>
        <Style>
          <TextAlign>Center</TextAlign>
        </Style>
      </Textbox>

      <!-- JOB ROLE -->
      <Textbox Name="JobRoleText">
        <Top>0.5in</Top>
        <Left>0in</Left>
        <Height>0.3in</Height>
        <Width>5in</Width>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Job Role: </Value>
                <Style><FontWeight>Bold</FontWeight></Style>
              </TextRun>
              <TextRun>
                <Value>=First(Fields!RoleApplied.Value, "CandidateDataSet")</Value>
                <Style/>
              </TextRun>
            </TextRuns>
            <Style/>
          </Paragraph>
        </Paragraphs>
        <Style/>
      </Textbox>

      <!-- TOTAL CANDIDATES -->
      <Textbox Name="TotalCandidatesText">
        <Top>0.8in</Top>
        <Left>0in</Left>
        <Height>0.3in</Height>
        <Width>5in</Width>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Total Candidates: </Value>
                <Style><FontWeight>Bold</FontWeight></Style>
              </TextRun>
              <TextRun>
                <Value>=CountRows("CandidateDataSet")</Value>
                <Style/>
              </TextRun>
            </TextRuns>
            <Style/>
          </Paragraph>
        </Paragraphs>
        <Style/>
      </Textbox>

      <!-- TOP CANDIDATE -->
      <Textbox Name="TopCandidateText">
        <Top>1.1in</Top>
        <Left>0in</Left>
        <Height>0.3in</Height>
        <Width>5in</Width>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Top Candidate: </Value>
                <Style><FontWeight>Bold</FontWeight></Style>
              </TextRun>
              <TextRun>
                <Value>=First(Fields!CandidateName.Value, "CandidateDataSet")</Value>
                <Style/>
              </TextRun>
            </TextRuns>
            <Style/>
          </Paragraph>
        </Paragraphs>
        <Style/>
      </Textbox>

      <!-- GENERATED DATE -->
      <Textbox Name="GeneratedDateText">
        <Top>1.4in</Top>
        <Left>0in</Left>
        <Height>0.3in</Height>
        <Width>5in</Width>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Generated On: </Value>
                <Style><FontWeight>Bold</FontWeight></Style>
              </TextRun>
              <TextRun>
                <Value>=Format(Today(),"dd/MM/yyyy")</Value>
                <Style/>
              </TextRun>
            </TextRuns>
            <Style/>
          </Paragraph>
        </Paragraphs>
        <Style/>
      </Textbox>

      <!-- TABLE -->
      <Tablix Name="CandidateTablix">
        <Top>2.2in</Top>
        <Left>0in</Left>
        <DataSetName>CandidateDataSet</DataSetName>

        <TablixBody>
          <TablixColumns>
            <TablixColumn><Width>0.8in</Width></TablixColumn>
            <TablixColumn><Width>2in</Width></TablixColumn>
            <TablixColumn><Width>2.3in</Width></TablixColumn>
            <TablixColumn><Width>1in</Width></TablixColumn>
            <TablixColumn><Width>1.5in</Width></TablixColumn>
            <TablixColumn><Width>2in</Width></TablixColumn>
          </TablixColumns>

          <TablixRows>

            <!-- HEADER ROW -->
            <TablixRow>
              <Height>0.4in</Height>
              <TablixCells>
                <TablixCell><CellContents><Textbox Name="H1"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Rank</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Style/></Textbox></CellContents></TablixCell>

                <TablixCell><CellContents><Textbox Name="H2"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Candidate Name</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Style/></Textbox></CellContents></TablixCell>

                <TablixCell><CellContents><Textbox Name="H3"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Email</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Style/></Textbox></CellContents></TablixCell>

                <TablixCell><CellContents><Textbox Name="H4"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Score</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Style/></Textbox></CellContents></TablixCell>

                <TablixCell><CellContents><Textbox Name="H5"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Degree</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Style/></Textbox></CellContents></TablixCell>

                <TablixCell><CellContents><Textbox Name="H6"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Role Applied</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Style/></Textbox></CellContents></TablixCell>
              </TablixCells>
            </TablixRow>

            <!-- DATA ROW -->
            <TablixRow>
              <Height>0.4in</Height>
              <TablixCells>

                <TablixCell><CellContents><Textbox Name="D1"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Rank.Value</Value><Style/></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Style/></Textbox></CellContents></TablixCell>

                <TablixCell><CellContents><Textbox Name="D2"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!CandidateName.Value</Value><Style/></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Style/></Textbox></CellContents></TablixCell>

                <TablixCell><CellContents><Textbox Name="D3"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Email.Value</Value><Style/></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Style/></Textbox></CellContents></TablixCell>

                <TablixCell><CellContents><Textbox Name="D4"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Score.Value</Value><Style/></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Style/></Textbox></CellContents></TablixCell>

                <TablixCell><CellContents><Textbox Name="D5"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Degree.Value</Value><Style/></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Style/></Textbox></CellContents></TablixCell>

                <TablixCell><CellContents><Textbox Name="D6"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!RoleApplied.Value</Value><Style/></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Style/></Textbox></CellContents></TablixCell>

              </TablixCells>
            </TablixRow>

          </TablixRows>
        </TablixBody>

        <TablixRowHierarchy>
          <TablixMembers>
            <TablixMember/>
            <TablixMember>
              <Group Name="DetailGroup"/>
            </TablixMember>
          </TablixMembers>
        </TablixRowHierarchy>

        <TablixColumnHierarchy>
          <TablixMembers>
            <TablixMember/>
            <TablixMember/>
            <TablixMember/>
            <TablixMember/>
            <TablixMember/>
            <TablixMember/>
          </TablixMembers>
        </TablixColumnHierarchy>

      </Tablix>

    </ReportItems>

    <Height>6in</Height>
  </Body>

  <Width>10in</Width>

  <Page>
    <PageHeight>11in</PageHeight>
    <PageWidth>8.5in</PageWidth>
    <LeftMargin>0.5in</LeftMargin>
    <RightMargin>0.5in</RightMargin>
    <TopMargin>0.5in</TopMargin>
    <BottomMargin>0.5in</BottomMargin>
  </Page>

</Report>